# Backend API — e.g. https://mycredaxis.com/api (via nginx reverse proxy)

PORT=5000
NODE_ENV=production

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

MONGO_USER=
MONGO_PASSWORD=
MONGO_HOST=
MONGO_DB=
MONGO_OPTIONS=

# Optional: restrict browser origins (app currently allows all with origin:true)
# CORS_ORIGIN=https://mycredaxis.com

# Decentro
DECENTRO_BASE_URL=https://in.decentro.tech
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_CREDIT_REPORT_PATH=/v2/financial_services/credit_bureau/credit_report/summary
DECENTRO_TIMEOUT_MS=60000

# Razorpay (shared — wallet top-up, credit check, etc.)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Play Store / app review demo login (optional — set before Play Console submission)
# Reviewers: enter PLAY_REVIEW_MOBILE → OTP is always PLAY_REVIEW_OTP (no SMS sent)
PLAY_REVIEW_MOBILE=8888012345
PLAY_REVIEW_OTP=123456

FAST2SMS_API_KEY=
FAST2SMS_ENDPOINT=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
FAST2SMS_LANGUAGE=english
FAST2SMS_TIMEOUT_MS=15000

# Mandate SMS (DLT) — paste Fast2SMS template IDs; leave empty to skip that SMS
MANDATE_SMS_ENABLED=true
FAST2SMS_DLT_MANDATE_ACTIVE_CUSTOMER=
FAST2SMS_DLT_MANDATE_ACTIVE_MERCHANT=
FAST2SMS_DLT_COLLECTION_CUSTOMER=
FAST2SMS_DLT_COLLECTION_MERCHANT=
FAST2SMS_DLT_SETTLEMENT_CUSTOMER=
FAST2SMS_DLT_SETTLEMENT_MERCHANT=

# RocketPay Mandate V4
ROCKETPAY_BASE_URL=https://api-staging.rocketpay.co.in
ENTERPRISE_ID=0000019d-dd93-6326-91cf-17922df365d4
ROCKETPAY_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..F6-zKXiWcLIKccnxoh-mI6plqkf5SpezATVdjM6tvLM
ROCKETPAY_APP_CONTEXT=MERCHANT_API
ROCKETPAY_TIMEOUT_MS=60000
# Optional — if set, webhook must send matching x-webhook-secret
ROCKETPAY_WEBHOOK_SECRET=